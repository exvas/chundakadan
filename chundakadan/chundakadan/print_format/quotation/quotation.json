 "css": ".print-format label {\n    color: #74808b;\n    font-size: 12px;\n    margin-bottom: 4px;\n    text-transform: uppercase;\n}\n.print-format td, .print-format th {\n    vertical-align: middle;\n}\n.print-format h2 {\n    color: #1a237e;\n}\n.print-format .table > thead > tr > th {\n    background-color: #f4f5f6;\n    border-bottom: 2px solid #1a237e;\n    padding: 5px 4px;\n    font-size: 10px;\n}\n.print-format .table-bordered > thead > tr > th {\n    border: 1px solid #d1d8dd;\n}\n.print-format .table-bordered > tbody > tr > td {\n    border: 1px solid #d1d8dd;\n}\n.print-format .table-condensed > tbody > tr > td {\n    padding: 4px 5px;\n}\n.letter-head { margin-bottom: 8px; }\n.letter-head-footer { margin-bottom: 4px; }\n.hidden-pdf { display: none; }\n.visible-pdf { display: block !important; }\n@media screen {\n    .visible-pdf { display: none !important; }\n}\n",
