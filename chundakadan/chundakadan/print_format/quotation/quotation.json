 "doctype": "Print Format",
 "font_size": 14,
 "html": "{%- macro add_header(page_num, max_pages, doc, letter_head, no_letterhead, footer, print_settings=None) -%}\n    {% if letter_head and not no_letterhead %}\n        <div class=\"letter-head\">{{ letter_head }}</div>\n    {% endif %}\n    <div class=\"print-heading\">\n        <h2 style=\"margin: 0 0 2px; font-size: 20pt; font-weight: 700; letter-spacing: 3px;\">QUOTATION</h2>\n    </div>\n    {%- if doc.docstatus==2 -%}\n    <div class=\"text-center\" document-status=\"cancelled\">\n        <h4 style=\"margin: 0;\">{{ _(\"CANCELLED\") }}</h4>\n    </div>\n    {%- endif -%}\n{%- endmacro -%}\n\n{% for page in layout %}\n<div class=\"page-break\">\n    <div {% if print_settings.repeat_header_footer %} id=\"header-html\" class=\"hidden-pdf\" {% endif %}>\n        {{ add_header(loop.index, layout|len, doc, letter_head, no_letterhead, footer, print_settings) }}\n    </div>\n\n    {% if print_settings.repeat_header_footer %}\n    <div id=\"footer-html\" class=\"visible-pdf\">\n        {% if not no_letterhead and footer %}\n        <div class=\"letter-head-footer\">\n            {{ footer }}\n        </div>\n        {% endif %}\n        <p class=\"text-center small page-number visible-pdf\">\n            {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\n        </p>\n    </div>\n    {% endif %}\n\n    <div class=\"row section-break\" style=\"margin-bottom: 12px;\">\n        <div class=\"col-xs-7\">\n            <label>{{ _(\"To\") }}</label>\n            <div style=\"font-size: 12pt; font-weight: 700;\">{{ doc.customer_name or \"\" }}</div>\n            {% if doc.address_display %}\n            <div style=\"font-size: 9pt; color: #555;\">{{ doc.address_display | replace(\"\\n\", \"<br>\") | safe }}</div>\n            {% endif %}\n        </div>\n        <div class=\"col-xs-5\" style=\"text-align: right;\">\n            <div style=\"margin-bottom: 10px;\">\n                <div><label>{{ _(\"Quotation No\") }}</label></div>\n                <div style=\"font-weight: 600;\">{{ doc.name }}</div>\n            </div>\n            <div style=\"margin-bottom: 10px;\">\n                <div><label>{{ _(\"Date\") }}</label></div>\n                <div>{{ frappe.utils.format_date(doc.transaction_date) if doc.transaction_date else \"\" }}</div>\n            </div>\n            {% if doc.valid_till %}\n            <div style=\"margin-bottom: 10px;\">\n                <div><label>{{ _(\"Valid Till\") }}</label></div>\n                <div>{{ frappe.utils.format_date(doc.valid_till) }}</div>\n            </div>\n            {% endif %}\n            {% if doc.kind_attention %}\n            <div style=\"margin-bottom: 10px;\">\n                <div><label>{{ _(\"Kind Attention\") }}</label></div>\n                <div>{{ doc.kind_attention }}</div>\n            </div>\n            {% endif %}\n            {% if doc.company_gstin %}\n            <div>\n                <div><label>{{ _(\"GSTIN\") }}</label></div>\n                <div>{{ doc.company_gstin }}</div>\n            </div>\n            {% endif %}\n        </div>\n    </div>\n\n    {% if doc.subject or doc.project_name %}\n    <div class=\"row section-break\" style=\"margin-bottom: 10px;\">\n        <div class=\"col-xs-12\">\n            <div style=\"background: #fff9c4; border-left: 4px solid #f9a825; padding: 6px 10px; font-size: 10pt;\">\n                {% if doc.subject %}<strong>{{ _(\"Subject\") }}:</strong> {{ doc.subject }}{% endif %}\n                {% if doc.project_name %}{% if doc.subject %} &nbsp;|&nbsp; {% endif %}<strong>{{ _(\"Project\") }}:</strong> {{ doc.project_name }}{% endif %}\n            </div>\n        </div>\n    </div>\n    {% endif %}\n\n    <div class=\"row section-break\">\n        <div class=\"col-xs-12\">\n            <table class=\"table table-bordered table-condensed\" style=\"width: 100%; font-size: 11px; margin-bottom: 0;\">\n                <colgroup>\n                    <col style=\"width: 4%;\">\n                    <col style=\"width: 48%;\">\n                    <col style=\"width: 8%;\">\n                    <col style=\"width: 8%;\">\n                    <col style=\"width: 16%;\">\n                    <col style=\"width: 16%;\">\n                </colgroup>\n                <thead>\n                    <tr>\n                        <th class=\"text-uppercase text-center\">{{ _(\"Sr\") }}</th>\n                        <th class=\"text-uppercase text-center\">{{ _(\"Description\") }}</th>\n                        <th class=\"text-uppercase text-center\">{{ _(\"UOM\") }}</th>\n                        <th class=\"text-uppercase text-center\">{{ _(\"Qty\") }}</th>\n                        <th class=\"text-uppercase text-right\">{{ _(\"Rate\") }} ({{ doc.currency or \"\" }})</th>\n                        <th class=\"text-uppercase text-right\">{{ _(\"Amount\") }} ({{ doc.currency or \"\" }})</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    {% for item in doc.items %}\n                    <tr>\n                        <td class=\"text-center\">{{ item.idx }}</td>\n                        <td>\n                            <b>{{ item.item_code }}</b>\n                            {% if item.item_name != item.item_code %}<br><span style=\"color: #333;\">{{ item.item_name }}</span>{% endif %}\n                            {% if item.description and item.description.strip() and item.description != item.item_name %}\n                                <br><span style=\"color: #888; font-size: 10px;\">{{ item.description }}</span>\n                            {% endif %}\n                        </td>\n                        <td class=\"text-center\">{{ item.uom or \"\" }}</td>\n                        <td class=\"text-center\">{{ item.get_formatted(\"qty\", doc) }}</td>\n                        <td class=\"text-right\">{{ item.get_formatted(\"rate\", doc) }}</td>\n                        <td class=\"text-right\">{{ item.get_formatted(\"amount\", doc) }}</td>\n                    </tr>\n                    {% endfor %}\n                </tbody>\n            </table>\n        </div>\n    </div>\n\n    <div class=\"row section-break\">\n        <div class=\"col-xs-7\">\n            <div style=\"margin-bottom: 15px;\">\n                <label>{{ _(\"Amount in Words\") }}</label>\n                <div style=\"font-style: italic; color: #555;\">{{ frappe.utils.money_in_words(doc.rounded_total or doc.grand_total, doc.currency) }}</div>\n            </div>\n            {% if doc.terms %}\n            <div>\n                <label>{{ _(\"Terms and Conditions\") }}</label>\n                <div style=\"font-size: 9pt; color: #555;\">{{ doc.terms }}</div>\n            </div>\n            {% endif %}\n            {% if doc.company_bank %}\n            <div style=\"margin-top: 10px;\">\n                <label>{{ _(\"Bank Details\") }}</label>\n                <div style=\"font-size: 9pt;\">{{ doc.company_bank }}</div>\n            </div>\n            {% endif %}\n        </div>\n        <div class=\"col-xs-5\">\n            <div style=\"border: 1px solid #d1d8dd; padding: 8px 12px;\">\n                <div class=\"row\" style=\"margin: 0;\">\n                    <div style=\"width: 55%; display: inline-block;\"><b>{{ _(\"Net Total\") }}</b></div>\n                    <div style=\"width: 45%; display: inline-block; text-align: right;\">{{ doc.get_formatted(\"total\") }}</div>\n                </div>\n                {% if doc.discount_amount %}\n                <div class=\"row\" style=\"margin: 4px 0;\">\n                    <div style=\"width: 55%; display: inline-block;\">{{ _(\"Discount\") }}</div>\n                    <div style=\"width: 45%; display: inline-block; text-align: right;\">{{ doc.get_formatted(\"discount_amount\") }}</div>\n                </div>\n                {% endif %}\n                {% for tax in doc.taxes %}\n                {% if tax.tax_amount %}\n                <div class=\"row\" style=\"margin: 4px 0;\">\n                    <div style=\"width: 55%; display: inline-block;\">{{ tax.description }}</div>\n                    <div style=\"width: 45%; display: inline-block; text-align: right;\">{{ tax.get_formatted(\"tax_amount\") }}</div>\n                </div>\n                {% endif %}\n                {% endfor %}\n                <hr style=\"margin: 6px 0; border-color: #1a237e;\">\n                <div class=\"row\" style=\"margin: 0;\">\n                    <div style=\"width: 55%; display: inline-block; font-size: 12pt; font-weight: 700;\">{{ _(\"Grand Total\") }}</div>\n                    <div style=\"width: 45%; display: inline-block; text-align: right; font-size: 12pt; font-weight: 700;\">{{ doc.get_formatted(\"grand_total\") }}</div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"row section-break\" style=\"margin-top: 20px;\">\n        <div class=\"col-xs-6\">\n            <div>\n                <label>{{ _(\"Prepared By\") }}</label>\n                <div>{{ doc.owner or frappe.session.user }}</div>\n            </div>\n        </div>\n        <div class=\"col-xs-6\" style=\"text-align: right;\">\n            <div>\n                <label>{{ _(\"For\") }} {{ doc.company or \"\" }}</label>\n            </div>\n            <div style=\"margin-top: 30px; display: inline-block; border-top: 1px solid #000; min-width: 150px; padding-top: 4px; font-size: 9pt; color: #666; text-align: center;\">\n                {{ _(\"Authorized Signatory\") }}\n            </div>\n        </div>\n    </div>\n</div>\n{% endfor %}\n",
